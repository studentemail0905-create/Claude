# Copy this file to .env and fill in real values. Never commit .env.

### Medium authentication (required) ##########################################
# Self-issued integration token from https://medium.com/me/settings/security
# ("Integration tokens" section). Grants this server full API access to your
# Medium account -- treat it like a password.
MEDIUM_INTEGRATION_TOKEN=

# Rarely need to change these.
MEDIUM_API_BASE_URL=https://api.medium.com/v1
MEDIUM_RSS_BASE_URL=https://medium.com
MEDIUM_REQUEST_TIMEOUT_MS=10000

### This server's own transport & auth ########################################
# "http" runs the remote Streamable HTTP server (for Claude.ai, Claude Desktop
# custom connectors, or any remote MCP client). "stdio" runs a local process
# server (for Claude Desktop's local MCP server config, or debugging).
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# Bearer token clients must send as `Authorization: Bearer <token>` to reach
# any /mcp endpoint. Required whenever NODE_ENV=production and
# MCP_TRANSPORT=http, unless you explicitly set MCP_ALLOW_UNAUTHENTICATED=true
# (not recommended -- this token is your Medium account's front door).
# Generate one with: openssl rand -hex 32
MCP_SERVER_AUTH_TOKEN=

# Set to a specific origin (e.g. https://claude.ai) to allow browser-based MCP
# clients to call this server cross-origin. Leave blank to disable CORS.
MCP_CORS_ORIGIN=

### Feature toggles ############################################################
# Turn off whole tool groups per deployment, independent of confirmation
# behavior. All default to true.
MEDIUM_ENABLE_READ_TOOLS=true
MEDIUM_ENABLE_WRITE_TOOLS=true
MEDIUM_ENABLE_PUBLISH_TOOL=true

# How long a request_publish_confirmation token stays redeemable, in ms.
MEDIUM_PUBLISH_CONFIRMATION_TTL_MS=600000

### Logging #####################################################################
LOG_LEVEL=info
LOG_PRETTY=false

NODE_ENV=development
